<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}EnergyMe Monitor{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background: #0f1117; color: #e2e8f0; font-family: 'Segoe UI', sans-serif; }
    .navbar { background: #1a1d2e !important; border-bottom: 1px solid #2d3148; }
    .navbar-brand { color: #60a5fa !important; font-weight: 700; letter-spacing: 1px; }
    .nav-link { color: #94a3b8 !important; }
    .nav-link.active, .nav-link:hover { color: #60a5fa !important; }
    .card { background: #1a1d2e; border: 1px solid #2d3148; border-radius: 12px; }
    .card-header { background: #252840; border-bottom: 1px solid #2d3148; font-weight: 600; }
    .metric-value { font-size: 1.3rem; font-weight: 700; color: #60a5fa; }
    .metric-label { font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-online { background: #064e3b; color: #34d399; border: 1px solid #059669; }
    .badge-offline { background: #450a0a; color: #f87171; border: 1px solid #dc2626; }
    .table { color: #e2e8f0; }
    .table th { color: #94a3b8; border-color: #2d3148; font-size: 0.8rem; text-transform: uppercase; }
    .table td { border-color: #2d3148; vertical-align: middle; }
    .table-hover tbody tr:hover { background: #252840; }
    .form-control, .form-select { background: #0f1117; border-color: #2d3148; color: #e2e8f0; }
    .form-control:focus, .form-select:focus { background: #0f1117; border-color: #60a5fa; color: #e2e8f0; box-shadow: 0 0 0 0.2rem rgba(96,165,250,0.15); }
    .btn-primary { background: #2563eb; border-color: #2563eb; }
    .btn-primary:hover { background: #1d4ed8; border-color: #1d4ed8; }
    .stat-card { transition: transform 0.15s; }
    .stat-card:hover { transform: translateY(-2px); }
    .channel-col { min-width: 200px; }
    h5.section-title { color: #94a3b8; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem; }
    .param-desc { color: #94a3b8; font-size: 0.82rem; }
    .version-badge { font-size: 0.9rem; }
    .status-ok { color: #34d399; }
    .status-warn { color: #fbbf24; }
    .status-err { color: #f87171; }
    .info-row { padding: 0.4rem 0; border-bottom: 1px solid #2d3148; }
    .info-key { color: #cbd5e1; font-size: 0.85rem; }
    .info-val { font-weight: 600; }
    .trend-hint { font-size: .65rem; line-height: 1.2; margin-top: 1px; opacity: .85; }
    .trend-up   { color: #fb923c; }
    .trend-down { color: #34d399; }
    .trend-stable { color: #64748b; }
    .trend-unknown { color: #475569; }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg">
  <div class="container-fluid px-4">
    <a class="navbar-brand" href="/"><i class="bi bi-lightning-charge-fill me-2"></i>EnergyMe Monitor</a>
    <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto gap-1">
        <li class="nav-item">
          <a class="nav-link {% if page == 'metrics' %}active fw-semibold{% endif %}" href="/">
            <i class="bi bi-activity me-1"></i>Métriques
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {% if page == 'config' %}active fw-semibold{% endif %}" href="/config">
            <i class="bi bi-sliders me-1"></i>Configuration
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {% if page == 'system' %}active fw-semibold{% endif %}" href="/system">
            <i class="bi bi-cpu me-1"></i>Système
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<main class="container-fluid px-4 py-4">
  {% block content %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
