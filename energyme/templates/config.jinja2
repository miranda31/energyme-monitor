{% extends "base.jinja2" %}
{% block title %}Configuration ADE7953 – EnergyMe Monitor{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h2 class="mb-0 fw-bold">Configuration ADE7953</h2>
    <p class="text-muted mb-0">Registres de calibration lus depuis le dispositif EnergyMe</p>
  </div>
  <span class="badge bg-secondary fs-6 px-3 py-2">
    <i class="bi bi-chip me-1"></i>Analog Devices ADE7953
  </span>
</div>

{% if error %}
<div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
  <i class="bi bi-wifi-off fs-5"></i>
  <div><strong>Dispositif injoignable</strong> — {{ error }}</div>
</div>
{% endif %}

<!-- Onglets -->
<ul class="nav nav-tabs mb-3" id="configTabs">
  <li class="nav-item">
    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-registers">
      <i class="bi bi-table me-1"></i>Calibration globale
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-channels">
      <i class="bi bi-list-ul me-1"></i>Canaux
    </button>
  </li>
</ul>

<div class="tab-content">

<!-- Onglet Calibration globale -->
<div class="tab-pane fade show active" id="tab-registers">
{% if config_rows %}
<div class="card">
  <div class="card-header py-3">
    <i class="bi bi-table me-2 text-info"></i>Registres de calibration ADE7953
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th style="width:16%">Registre</th>
            <th style="width:16%">Valeur</th>
            <th style="width:10%">Unité</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {% for row in config_rows %}
          <tr>
            <td><code class="text-info">{{ row.name }}</code></td>
            <td class="font-monospace">
              {{ row.value }}
              {% if row.value is not none and row.value != 0 and row.value is number %}
              <small class="text-muted">({{ '0x%X' % row.value }})</small>
              {% endif %}
            </td>
            <td><span class="text-muted small">{{ row.unit or '—' }}</span></td>
            <td class="param-desc">{{ row.description }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% elif not error %}
<div class="alert alert-secondary">Aucune donnée de configuration reçue.</div>
{% endif %}
</div>

<!-- Onglet Canaux -->
<div class="tab-pane fade" id="tab-channels">
{% if channels %}
<div class="card p-0">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th style="width:45px">#</th>
          <th>Nom</th>
          <th>Rôle</th>
          <th class="text-end">Calibre TC (A)</th>
          <th class="text-end">Sortie TC (V)</th>
          <th class="text-end">Correction</th>
          <th class="text-center" style="width:80px">Sauv.</th>
        </tr>
      </thead>
      <tbody>
        {% for ch in channels %}
        {% set ct = ch.ctSpecification or {} %}
        <tr class="ch-config-row" data-channel="{{ ch.index }}">
          <td class="fw-bold text-muted px-3">{{ ch.index }}</td>
          <td>
            <div class="fw-semibold" style="font-size:.9rem">{{ ch.label or ('Canal ' ~ ch.index) }}</div>
            {% if ch.groupLabel %}<div class="text-muted" style="font-size:.72rem">{{ ch.groupLabel }}</div>{% endif %}
          </td>
          <td>
            <span class="badge bg-{{ ch.role_color | default('secondary') }} bg-opacity-25 text-{{ ch.role_color | default('secondary') }}"
                  style="border:1px solid;font-size:.7rem">
              {{ role_labels.get(ch.role, ch.role or '—') }}
            </span>
          </td>
          <td class="text-end">
            <input type="number" class="form-control form-control-sm text-end font-monospace ct-input"
                   name="ct_rating" value="{{ ct.currentRating or 50 }}"
                   min="1" max="300" step="0.1" style="width:90px;margin-left:auto">
          </td>
          <td class="text-end">
            <input type="number" class="form-control form-control-sm text-end font-monospace ct-input"
                   name="ct_voltage" value="{{ ct.voltageOutput or 1.0 }}"
                   min="0.1" max="1.0" step="0.001" style="width:90px;margin-left:auto">
          </td>
          <td class="text-end">
            <input type="number" class="form-control form-control-sm text-end font-monospace ct-input"
                   name="ct_scaling" value="{{ ct.scalingFraction or 0.0 }}"
                   min="-0.5" max="0.5" step="0.01" style="width:90px;margin-left:auto">
          </td>
          <td class="text-center">
            <button class="btn btn-primary btn-sm ct-save-btn px-2 py-0">
              <i class="bi bi-check-lg"></i>
            </button>
            <span class="ct-ok text-success d-none ms-1"><i class="bi bi-check-circle-fill"></i></span>
            <span class="ct-err text-danger d-none ms-1" title=""></span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% elif not error %}
<div class="alert alert-secondary">Aucun canal retourné par le dispositif.</div>
{% endif %}
</div>

</div><!-- /tab-content -->

<div class="row g-4 mt-1">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header py-3">
        <i class="bi bi-info-circle me-2 text-warning"></i>Rôles de canaux
      </div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <thead><tr><th>Rôle</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><span class="badge bg-primary">grid</span></td>
                <td>Réseau (import +, export −)</td></tr>
            <tr><td><span class="badge bg-warning text-dark">pv</span></td>
                <td>Panneau solaire (production)</td></tr>
            <tr><td><span class="badge bg-success">inverter</span></td>
                <td>Onduleur DC + batterie</td></tr>
            <tr><td><span class="badge bg-info text-dark">battery</span></td>
                <td>Batterie (décharge +, charge −)</td></tr>
            <tr><td><span class="badge bg-secondary">load</span></td>
                <td>Charge (consommation)</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header py-3">
        <i class="bi bi-book me-2 text-success"></i>Références
      </div>
      <div class="card-body">
        <ul class="list-unstyled mb-0">
          <li class="mb-2">
            <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
            <a href="https://www.analog.com/media/en/technical-documentation/data-sheets/ADE7953.pdf"
               target="_blank" class="text-info">Datasheet ADE7953 (Analog Devices)</a>
          </li>
          <li class="mb-2">
            <i class="bi bi-github text-light me-2"></i>
            <a href="https://github.com/jibrilsharafi/homeassistant-energyme"
               target="_blank" class="text-info">Intégration Home Assistant EnergyMe</a>
          </li>
          <li>
            <i class="bi bi-cpu me-2 text-warning"></i>
            Interface I²C — Adresse par défaut : <code>0x38</code>
          </li>
        </ul>
        <hr style="border-color:#2d3148">
        <p class="param-desc mb-0">
          L'ADE7953 mesure énergie active, réactive et apparente sur deux canaux de courant
          (A et B) avec un canal de tension partagé. Précision de classe 0,1 %.
          Le multiplexeur ESP32 démultiplexe jusqu'à 16 circuits.
        </p>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.querySelectorAll('.ch-config-row').forEach(row => {
  row.querySelector('.ct-save-btn').addEventListener('click', async () => {
    const ch   = row.dataset.channel;
    const okEl = row.querySelector('.ct-ok');
    const errEl= row.querySelector('.ct-err');
    const data = new URLSearchParams();
    row.querySelectorAll('.ct-input').forEach(inp => data.append(inp.name, inp.value));
    try {
      const resp = await fetch(`/channel/${ch}/update`, {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: data,
      });
      const json = await resp.json();
      if (json.status === 'ok') {
        okEl.classList.remove('d-none');
        errEl.classList.add('d-none');
        setTimeout(() => okEl.classList.add('d-none'), 2500);
      } else throw new Error(json.message || 'Erreur');
    } catch(e) {
      errEl.innerHTML = `<i class="bi bi-x-circle-fill"></i>`;
      errEl.title = e.message;
      errEl.classList.remove('d-none');
      okEl.classList.add('d-none');
    }
  });
});
</script>
{% endblock %}
