{% extends "base.jinja2" %}
{% block title %}Issues – EnergyMe Monitor{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <h2 class="mb-0 fw-bold">Issues</h2>
    <p class="text-muted mb-0 small">
      {% if error_count %}<span class="text-danger fw-semibold">{{ error_count }} erreur{{ 's' if error_count > 1 }}</span>{% endif %}
      {% if warning_count %}<span class="text-warning fw-semibold ms-2">{{ warning_count }} avertissement{{ 's' if warning_count > 1 }}</span>{% endif %}
      {% if info_count %}<span class="text-info fw-semibold ms-2">{{ info_count }} info{{ 's' if info_count > 1 }}</span>{% endif %}
      {% if not error_count and not warning_count and not info_count and not error %}
        <span class="text-success fw-semibold">Aucune issue active non acquittée</span>
      {% endif %}
    </p>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-sm btn-outline-warning" id="btn-ack-all">
      <i class="bi bi-check2-all me-1"></i>Acquitter tout
    </button>
    <button class="btn btn-sm btn-outline-info" onclick="location.reload()">
      <i class="bi bi-arrow-clockwise"></i>
    </button>
  </div>
</div>

{% if error %}
<div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
  <i class="bi bi-wifi-off fs-5"></i>
  <div><strong>Dispositif injoignable</strong> — {{ error }}</div>
</div>
{% endif %}

{% if issues %}
<div class="card p-0">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th style="width:40px">Sév.</th>
          <th style="min-width:140px">Code</th>
          <th>Message</th>
          <th style="width:70px" class="text-center">Canal</th>
          <th style="min-width:140px">Première</th>
          <th style="min-width:140px">Dernière</th>
          <th class="text-center" style="width:60px">Nb</th>
          <th style="min-width:130px">État</th>
          <th class="text-center" style="width:80px">Action</th>
        </tr>
      </thead>
      <tbody>
        {% for issue in issues %}
        {% set sev = issue.severity | default('info') %}
        {% set state = issue.state | default('active_unacked') %}
        <tr class="issue-row" data-code="{{ issue.code | default('') }}"
            data-channel="{{ issue.channel if issue.channel is defined else '' }}">

          <td class="text-center">
            {% if sev == 'error' %}
              <i class="bi bi-x-circle-fill text-danger fs-5" title="Erreur"></i>
            {% elif sev == 'warning' %}
              <i class="bi bi-exclamation-triangle-fill text-warning fs-5" title="Avertissement"></i>
            {% else %}
              <i class="bi bi-info-circle-fill text-info fs-5" title="Info"></i>
            {% endif %}
          </td>

          <td><code class="text-{{ 'danger' if sev == 'error' else ('warning' if sev == 'warning' else 'info') }}">
            {{ issue.code | default('—') }}</code></td>

          <td>{{ issue.message | default('—') }}</td>

          <td class="text-center font-monospace">
            {{ issue.channel if issue.channel is defined else '—' }}
          </td>

          <td class="small text-muted font-monospace">
            {{ issue.firstOccurrence | default('—') }}
          </td>
          <td class="small text-muted font-monospace">
            {{ issue.lastOccurrence | default('—') }}
          </td>

          <td class="text-center font-monospace">{{ issue.occurrenceCount | default('—') }}</td>

          <td>
            {% if state == 'active_unacked' %}
              <span class="badge bg-danger bg-opacity-25 text-danger border border-danger"
                    style="animation:pulse 1.5s infinite">Actif non-ack</span>
            {% elif state == 'active_acked' %}
              <span class="badge bg-warning bg-opacity-25 text-warning border border-warning">Actif acquitté</span>
            {% elif state == 'cleared_unacked' %}
              <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary">Résolu non-ack</span>
            {% else %}
              <span class="badge bg-secondary">{{ state }}</span>
            {% endif %}
          </td>

          <td class="text-center">
            {% if state in ('active_unacked', 'cleared_unacked') %}
            <button class="btn btn-sm btn-outline-secondary ack-btn px-2 py-0">
              <i class="bi bi-check-lg"></i>
            </button>
            {% endif %}
            <span class="ack-ok text-success d-none ms-1"><i class="bi bi-check-circle-fill"></i></span>
            <span class="ack-err text-danger d-none ms-1"><i class="bi bi-x-circle-fill"></i></span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% elif not error %}
<div class="alert alert-success d-flex align-items-center gap-2">
  <i class="bi bi-check-circle-fill fs-5"></i>
  <div>Aucune issue à signaler.</div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<style>
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.5} }
</style>
<script>
async function ackIssue(code, channel, all = false) {
  const data = new URLSearchParams();
  if (all) { data.append('all', '1'); }
  else {
    if (code)    data.append('code', code);
    if (channel !== '') data.append('channel', channel);
  }
  const resp = await fetch('/issues/ack', {
    method: 'POST',
    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
    body: data,
  });
  return resp.json();
}

document.querySelectorAll('.issue-row').forEach(row => {
  const btn = row.querySelector('.ack-btn');
  if (!btn) return;
  btn.addEventListener('click', async () => {
    const okEl  = row.querySelector('.ack-ok');
    const errEl = row.querySelector('.ack-err');
    try {
      const json = await ackIssue(row.dataset.code, row.dataset.channel);
      if (json.status === 'ok') {
        okEl.classList.remove('d-none');
        btn.classList.add('d-none');
        setTimeout(() => location.reload(), 1200);
      } else throw new Error(json.message);
    } catch(e) {
      errEl.title = e.message;
      errEl.classList.remove('d-none');
    }
  });
});

document.getElementById('btn-ack-all').addEventListener('click', async () => {
  try {
    const json = await ackIssue(null, null, true);
    if (json.status === 'ok') setTimeout(() => location.reload(), 800);
  } catch(e) { console.error(e); }
});
</script>
{% endblock %}
