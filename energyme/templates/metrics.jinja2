{% extends "base.jinja2" %}
{% block title %}Métriques – EnergyMe Monitor{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h2 class="mb-0 fw-bold">Métriques en temps réel</h2>
    <p class="text-muted mb-0">ADE7953 – Mesure d'énergie monophasée</p>
  </div>
  <button class="btn btn-sm btn-outline-info" onclick="refreshMetrics()">
    <i class="bi bi-arrow-clockwise me-1"></i>Rafraîchir
  </button>
</div>

<div class="row g-4" id="channels-container">
{% for ch_id, ch in channels.items() %}
<div class="col-xl-6 col-lg-12">
  <div class="card stat-card h-100">
    <div class="card-header d-flex align-items-center justify-content-between py-3">
      <div class="d-flex align-items-center gap-3">
        <span class="fs-5 fw-bold">{{ ch.label }}</span>
        {% if ch.online %}
        <span class="badge badge-online rounded-pill px-3 py-1">
          <i class="bi bi-circle-fill me-1" style="font-size:0.5rem"></i>EN LIGNE
        </span>
        {% else %}
        <span class="badge badge-offline rounded-pill px-3 py-1">
          <i class="bi bi-circle-fill me-1" style="font-size:0.5rem"></i>HORS LIGNE
        </span>
        {% endif %}
      </div>
      <i class="bi bi-plug text-info fs-5"></i>
    </div>

    <div class="card-body">
      <!-- Métriques principales -->
      <h5 class="section-title"><i class="bi bi-bar-chart-fill me-1"></i>Mesures</h5>
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
          <div class="p-3 rounded" style="background:#111827">
            <div class="metric-label">Tension RMS</div>
            <div class="metric-value">{{ ch.vrms }} <small class="fs-6">V</small></div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="p-3 rounded" style="background:#111827">
            <div class="metric-label">Courant RMS</div>
            <div class="metric-value">{{ ch.irms }} <small class="fs-6">A</small></div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="p-3 rounded" style="background:#111827">
            <div class="metric-label">Fréquence</div>
            <div class="metric-value">{{ ch.frequency }} <small class="fs-6">Hz</small></div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="p-3 rounded" style="background:#111827">
            <div class="metric-label">Puissance Active</div>
            <div class="metric-value" style="color:#34d399">{{ ch.active_power }} <small class="fs-6">W</small></div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="p-3 rounded" style="background:#111827">
            <div class="metric-label">Puissance Réactive</div>
            <div class="metric-value" style="color:#fbbf24">{{ ch.reactive_power }} <small class="fs-6">VAR</small></div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="p-3 rounded" style="background:#111827">
            <div class="metric-label">Puissance Apparente</div>
            <div class="metric-value" style="color:#a78bfa">{{ ch.apparent_power }} <small class="fs-6">VA</small></div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="p-3 rounded" style="background:#111827">
            <div class="metric-label">Facteur de Puissance</div>
            <div class="metric-value">{{ ch.power_factor }}</div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="p-3 rounded" style="background:#111827">
            <div class="metric-label">Énergie Active</div>
            <div class="metric-value" style="color:#34d399">{{ ch.active_energy }} <small class="fs-6">Wh</small></div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="p-3 rounded" style="background:#111827">
            <div class="metric-label">Énergie Apparente</div>
            <div class="metric-value" style="color:#a78bfa">{{ ch.apparent_energy }} <small class="fs-6">VAh</small></div>
          </div>
        </div>
      </div>

      <!-- Paramètres du canal -->
      <h5 class="section-title mt-3"><i class="bi bi-gear-fill me-1"></i>Paramètres canal {{ ch_id }}</h5>
      <form class="channel-form" data-channel="{{ ch_id }}">
        <div class="row g-2">
          {% for p in channel_params %}
          <div class="col-12 col-sm-6">
            <label class="form-label mb-1 text-muted" style="font-size:0.78rem">{{ p.label }}</label>
            {% if p.type == 'select' %}
            <select class="form-select form-select-sm" name="{{ p.name }}">
              {% for k, v in p.options.items() %}
              <option value="{{ k }}" {% if ch.settings[p.name] == k %}selected{% endif %}>{{ v }}</option>
              {% endfor %}
            </select>
            {% elif p.type == 'bool' %}
            <div class="form-check mt-1">
              <input class="form-check-input" type="checkbox" name="{{ p.name }}" id="{{ ch_id }}_{{ p.name }}"
                     value="1" {% if ch.settings[p.name] %}checked{% endif %}>
              <label class="form-check-label text-muted" for="{{ ch_id }}_{{ p.name }}">Activer</label>
            </div>
            {% else %}
            <input type="number" class="form-control form-control-sm" name="{{ p.name }}"
                   value="{{ ch.settings[p.name] }}"
                   min="{{ p.min }}" max="{{ p.max }}">
            {% endif %}
          </div>
          {% endfor %}
        </div>
        <div class="d-flex align-items-center gap-2 mt-3">
          <button type="submit" class="btn btn-primary btn-sm px-4">
            <i class="bi bi-save me-1"></i>Appliquer
          </button>
          <span class="save-status text-success small d-none">
            <i class="bi bi-check-circle me-1"></i>Sauvegardé
          </span>
          <span class="save-error text-danger small d-none">
            <i class="bi bi-x-circle me-1"></i>Erreur
          </span>
        </div>
      </form>
    </div>
  </div>
</div>
{% endfor %}
</div>
{% endblock %}

{% block scripts %}
<script>
document.querySelectorAll('.channel-form').forEach(form => {
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const ch = form.dataset.channel;
    const statusOk = form.querySelector('.save-status');
    const statusErr = form.querySelector('.save-error');
    const data = new URLSearchParams();
    new FormData(form).forEach((v, k) => data.append(k, v));
    // Checkboxes not checked won't appear in FormData
    form.querySelectorAll('input[type=checkbox]').forEach(cb => {
      if (!cb.checked) data.append(cb.name, '0');
    });
    try {
      const resp = await fetch(`/channel/${ch}/update`, {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: data,
      });
      if (resp.ok) {
        statusOk.classList.remove('d-none');
        statusErr.classList.add('d-none');
        setTimeout(() => statusOk.classList.add('d-none'), 3000);
      } else { throw new Error(); }
    } catch {
      statusErr.classList.remove('d-none');
      statusOk.classList.add('d-none');
    }
  });
});

function refreshMetrics() {
  location.reload();
}

// Auto-refresh toutes les 10s
setTimeout(() => location.reload(), 10000);
</script>
{% endblock %}
