{% extends "base.jinja2" %}
{% block title %}Métriques – EnergyMe Monitor{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <h2 class="mb-0 fw-bold">Métriques – 16 canaux</h2>
    <p class="text-muted mb-0 small">ADE7953 · Auto-refresh <span id="countdown">10</span>s</p>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-sm btn-outline-secondary" id="btn-toggle-params">
      <i class="bi bi-sliders me-1"></i>Paramètres
    </button>
    <button class="btn btn-sm btn-outline-info" onclick="location.reload()">
      <i class="bi bi-arrow-clockwise me-1"></i>Rafraîchir
    </button>
  </div>
</div>

<div class="card p-0">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="metrics-table">
      <thead>
        <tr>
          <!-- Identité -->
          <th class="text-center px-3" style="min-width:60px">#</th>
          <th style="min-width:80px">État</th>

          <!-- Mesures -->
          <th class="text-end" style="min-width:90px">V<sub>rms</sub> (V)</th>
          <th class="text-end" style="min-width:90px">I<sub>rms</sub> (A)</th>
          <th class="text-end" style="min-width:100px">P active (W)</th>
          <th class="text-end" style="min-width:110px">P réactive (VAR)</th>
          <th class="text-end" style="min-width:110px">P apparente (VA)</th>
          <th class="text-end" style="min-width:60px">PF</th>
          <th class="text-end" style="min-width:75px">Fréq. (Hz)</th>
          <th class="text-end" style="min-width:90px">Énergie (Wh)</th>

          <!-- Paramètres (masquables) -->
          <th class="col-param text-center" style="min-width:90px">Actif</th>
          <th class="col-param" style="min-width:120px">Mode</th>
          <th class="col-param text-center" style="min-width:80px">Inversion</th>
          <th class="col-param" style="min-width:100px">Gain PGA</th>
          <th class="col-param text-end" style="min-width:90px">Cal.Phase</th>
          <th class="col-param text-end" style="min-width:95px">Gain I</th>
          <th class="col-param text-end" style="min-width:90px">Offset I</th>
          <th class="col-param text-center" style="min-width:80px">No-Load</th>
          <th class="col-param text-center" style="min-width:80px">Sauv.</th>
        </tr>
      </thead>
      <tbody>
        {% for ch_id, ch in channels.items() %}
        <tr class="channel-row {% if not ch.online %}opacity-50{% endif %}" data-channel="{{ ch_id }}">

          <!-- # -->
          <td class="text-center fw-bold px-3">{{ ch_id }}</td>

          <!-- État -->
          <td>
            {% if ch.online %}
            <span class="badge badge-online rounded-pill px-2 py-1" style="font-size:.7rem">
              <i class="bi bi-circle-fill me-1" style="font-size:.45rem"></i>EN LIGNE
            </span>
            {% elif not ch.active %}
            <span class="badge rounded-pill px-2 py-1" style="font-size:.7rem;background:#1e293b;color:#64748b;border:1px solid #334155">
              <i class="bi bi-dash-circle me-1" style="font-size:.45rem"></i>INACTIF
            </span>
            {% else %}
            <span class="badge badge-offline rounded-pill px-2 py-1" style="font-size:.7rem">
              <i class="bi bi-circle-fill me-1" style="font-size:.45rem"></i>HORS LIGNE
            </span>
            {% endif %}
          </td>

          <!-- Mesures -->
          {% macro metric(val, color='') %}
            <td class="text-end font-monospace {% if color %}text-{{ color }}{% endif %}">
              {% if val is not none %}{{ val }}{% else %}<span class="text-muted">—</span>{% endif %}
            </td>
          {% endmacro %}

          {{ metric(ch.vrms) }}
          {{ metric(ch.irms) }}
          {{ metric(ch.active_power, 'success') }}
          {{ metric(ch.reactive_power, 'warning') }}
          {{ metric(ch.apparent_power) }}
          {{ metric(ch.power_factor) }}
          {{ metric(ch.frequency) }}
          {{ metric(ch.active_energy, 'info') }}

          <!-- Paramètres éditables -->
          <td class="col-param text-center">
            <div class="form-check d-flex justify-content-center mb-0">
              <input class="form-check-input param-input" type="checkbox" name="active"
                     {% if ch.settings.active %}checked{% endif %}>
            </div>
          </td>

          <td class="col-param">
            <select class="form-select form-select-sm param-input" name="mode" style="min-width:110px">
              {% for k, v in channel_modes.items() %}
              <option value="{{ k }}" {% if ch.settings.mode == k %}selected{% endif %}>{{ v }}</option>
              {% endfor %}
            </select>
          </td>

          <td class="col-param text-center">
            <div class="form-check d-flex justify-content-center mb-0">
              <input class="form-check-input param-input" type="checkbox" name="reverse"
                     {% if ch.settings.reverse %}checked{% endif %}>
            </div>
          </td>

          <td class="col-param">
            <select class="form-select form-select-sm param-input" name="gain" style="min-width:90px">
              {% for k, v in pga_gains.items() %}
              <option value="{{ k }}" {% if ch.settings.gain == k %}selected{% endif %}>{{ v }}</option>
              {% endfor %}
            </select>
          </td>

          <td class="col-param">
            <input type="number" class="form-control form-control-sm param-input text-end"
                   name="phase_cal" value="{{ ch.settings.phase_cal }}" min="-32" max="31"
                   style="width:80px;margin-left:auto">
          </td>

          <td class="col-param">
            <input type="number" class="form-control form-control-sm param-input text-end"
                   name="igain" value="{{ ch.settings.igain }}" min="-2097152" max="2097151"
                   style="width:90px;margin-left:auto">
          </td>

          <td class="col-param">
            <input type="number" class="form-control form-control-sm param-input text-end"
                   name="irmsos" value="{{ ch.settings.irmsos }}" min="-512" max="511"
                   style="width:80px;margin-left:auto">
          </td>

          <td class="col-param text-center">
            <div class="form-check d-flex justify-content-center mb-0">
              <input class="form-check-input param-input" type="checkbox" name="no_load"
                     {% if ch.settings.no_load %}checked{% endif %}>
            </div>
          </td>

          <td class="col-param text-center">
            <button class="btn btn-primary btn-sm save-btn px-2 py-0" title="Appliquer">
              <i class="bi bi-check-lg"></i>
            </button>
            <span class="save-ok text-success d-none ms-1"><i class="bi bi-check-circle-fill"></i></span>
            <span class="save-err text-danger d-none ms-1"><i class="bi bi-x-circle-fill"></i></span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<!-- Résumé global -->
<div class="row g-3 mt-2">
  {% set online = channels.values() | selectattr('online') | list %}
  <div class="col-sm-6 col-lg-3">
    <div class="card text-center py-3">
      <div class="metric-label">Canaux en ligne</div>
      <div class="metric-value">{{ online | length }} <small class="fs-6 text-muted">/ {{ channels | length }}</small></div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card text-center py-3">
      <div class="metric-label">Puissance totale active</div>
      <div class="metric-value" style="color:#34d399">
        {{ (online | sum(attribute='active_power')) | round(1) }} <small class="fs-6">W</small>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card text-center py-3">
      <div class="metric-label">Puissance apparente totale</div>
      <div class="metric-value" style="color:#a78bfa">
        {{ (online | sum(attribute='apparent_power')) | round(1) }} <small class="fs-6">VA</small>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card text-center py-3">
      <div class="metric-label">Énergie totale</div>
      <div class="metric-value" style="color:#60a5fa">
        {{ (online | sum(attribute='active_energy')) | round(3) }} <small class="fs-6">Wh</small>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
// Toggle colonnes paramètres
const paramCols = document.querySelectorAll('.col-param');
let paramsVisible = false;

function applyVisibility() {
  paramCols.forEach(el => el.classList.toggle('d-none', !paramsVisible));
}
applyVisibility();

document.getElementById('btn-toggle-params').addEventListener('click', () => {
  paramsVisible = !paramsVisible;
  applyVisibility();
  document.getElementById('btn-toggle-params').innerHTML =
    paramsVisible
      ? '<i class="bi bi-eye-slash me-1"></i>Masquer paramètres'
      : '<i class="bi bi-sliders me-1"></i>Paramètres';
});

// Sauvegarde par ligne
document.querySelectorAll('.channel-row').forEach(row => {
  row.querySelector('.save-btn').addEventListener('click', async () => {
    const ch = row.dataset.channel;
    const okEl  = row.querySelector('.save-ok');
    const errEl = row.querySelector('.save-err');
    const data  = new URLSearchParams();

    row.querySelectorAll('.param-input').forEach(input => {
      if (input.type === 'checkbox') {
        data.append(input.name, input.checked ? '1' : '0');
      } else {
        data.append(input.name, input.value);
      }
    });

    try {
      const resp = await fetch(`/channel/${ch}/update`, {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: data,
      });
      if (!resp.ok) throw new Error();
      okEl.classList.remove('d-none');
      errEl.classList.add('d-none');
      setTimeout(() => okEl.classList.add('d-none'), 2500);
    } catch {
      errEl.classList.remove('d-none');
      okEl.classList.add('d-none');
    }
  });
});

// Compte à rebours auto-refresh
let countdown = 10;
const countEl = document.getElementById('countdown');
setInterval(() => {
  countdown--;
  countEl.textContent = countdown;
  if (countdown <= 0) location.reload();
}, 1000);
</script>
{% endblock %}
