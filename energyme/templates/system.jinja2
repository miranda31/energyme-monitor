{% extends "base.jinja2" %}
{% block title %}Système – EnergyMe Monitor{% endblock %}

{% macro info_row(label, value, color='') %}
<div class="info-row d-flex justify-content-between">
  <span class="info-key">{{ label }}</span>
  <span class="info-val {% if color %}{{ color }}{% endif %}">{{ value }}</span>
</div>
{% endmacro %}

{% macro na() %}<span class="text-muted">—</span>{% endmacro %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h2 class="mb-0 fw-bold">Système</h2>
    <p class="text-muted mb-0">État du dispositif EnergyMe (ESP32)</p>
  </div>
  <button class="btn btn-sm btn-outline-info" onclick="location.reload()">
    <i class="bi bi-arrow-clockwise me-1"></i>Actualiser
  </button>
</div>

{% if error %}
<div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
  <i class="bi bi-wifi-off fs-5"></i>
  <div><strong>Dispositif injoignable</strong> — {{ error }}</div>
</div>
{% endif %}

<div class="row g-4">

  <!-- Firmware & mise à jour -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header py-3">
        <i class="bi bi-cpu me-2 text-info"></i>Firmware
      </div>
      <div class="card-body">
        {% if firmware %}
        {{ info_row("Version", firmware.buildVersion or na()) }}
        {{ info_row("Date de build", firmware.buildDate or na()) }}
        {% else %}
        <p class="text-muted">—</p>
        {% endif %}

        {% if firmware_info %}
        <hr style="border-color:#2d3148">
        {% if firmware_info.isLatest %}
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-success px-3 py-2">
            <i class="bi bi-check-circle me-1"></i>À jour
          </span>
          <span class="text-muted small">Version {{ firmware_info.currentVersion }}</span>
        </div>
        {% else %}
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-warning text-dark px-3 py-2">
            <i class="bi bi-arrow-up-circle me-1"></i>Mise à jour disponible
          </span>
        </div>
        <div class="mt-2">
          {{ info_row("Version disponible", firmware_info.availableVersion or na()) }}
        </div>
        {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Réseau -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header py-3">
        <i class="bi bi-wifi me-2 text-success"></i>Réseau
      </div>
      <div class="card-body">
        {% if network %}
        {{ info_row("Adresse IP",  network.wifiLocalIp or na()) }}
        {{ info_row("RSSI Wi-Fi",  (network.wifiRssi ~ " dBm") if network.wifiRssi is not none else na()) }}
        {% else %}
        <p class="text-muted">—</p>
        {% endif %}
        <hr style="border-color:#2d3148">
        {{ info_row("ID dispositif", device.id if device else na()) }}
        {% if factory %}
        {{ info_row("N° de série", factory.serialNumber or na()) }}
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Performance -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header py-3">
        <i class="bi bi-activity me-2 text-warning"></i>Performance
      </div>
      <div class="card-body">
        {% if performance %}
        {% set temp = performance.temperatureCelsius %}
        <div class="info-row d-flex justify-content-between">
          <span class="info-key">Température ESP32</span>
          <span class="info-val {% if temp and temp > 70 %}status-err{% elif temp and temp > 55 %}status-warn{% else %}status-ok{% endif %}">
            {% if temp is not none %}{{ temp }} °C{% else %}—{% endif %}
          </span>
        </div>
        {% endif %}
        {% if cpu %}
        {{ info_row("CPU Core 0", (cpu.core0Percent ~ " %") if cpu.core0Percent is not none else na()) }}
        {{ info_row("CPU Core 1", (cpu.core1Percent ~ " %") if cpu.core1Percent is not none else na()) }}
        {% endif %}
        {% if memory and memory.heap %}
        {{ info_row("Mémoire heap libre", (memory.heap.freePercentage ~ " %") if memory.heap.freePercentage is not none else na()) }}
        {% endif %}
        {% if storage and storage.littlefs %}
        {{ info_row("Stockage LittleFS libre", (storage.littlefs.freePercentage ~ " %") if storage.littlefs.freePercentage is not none else na()) }}
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Uptime -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header py-3">
        <i class="bi bi-clock-history me-2 text-purple"></i>Uptime
      </div>
      <div class="card-body">
        {% if uptime_device is not none %}
        {% set ud = uptime_device %}
        {% set ud_d = (ud // 86400) %}
        {% set ud_h = (ud % 86400) // 3600 %}
        {% set ud_m = (ud % 3600) // 60 %}
        {{ info_row("Dispositif EnergyMe", "%dd %02dh %02dm" % (ud_d, ud_h, ud_m)) }}
        {% else %}
        {{ info_row("Dispositif EnergyMe", na()) }}
        {% endif %}
        {{ info_row("Serveur web (ce processus)", uptime_server) }}
      </div>
    </div>
  </div>

  <!-- Stack logiciel -->
  <div class="col-12">
    <div class="card">
      <div class="card-header py-3">
        <i class="bi bi-layers me-2"></i>Stack logiciel
      </div>
      <div class="card-body">
        <div class="row g-3">
          {% for label, value in [
            ("Framework Web", "Pyramid"),
            ("Serveur WSGI",  "Waitress"),
            ("Templates",     "Jinja2"),
            ("Auth",          "HTTP Digest"),
            ("Client HTTP",   "requests"),
            ("Plateforme",    "ESP32 + ADE7953"),
          ] %}
          <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded text-center" style="background:#111827">
              <div class="metric-label">{{ label }}</div>
              <div class="fw-bold mt-1 small">{{ value }}</div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

</div>
{% endblock %}
